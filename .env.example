# Copy to web/.env.local for local dev. Never commit secrets.
# Production values go in Vercel env vars — see DEPLOY.md.

# 32-byte hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts every customer's Vercel token. Generate a NEW one for production.
TOKEN_ENCRYPTION_KEY=

# Signs the operator session cookie. Same generator. Falls back to TOKEN_ENCRYPTION_KEY.
AUTH_SECRET=

# Postgres, always. There is no SQLite any more.
# local:  postgres://localhost:5432/wrangler_dev
# prod:   the Supabase / Neon pooled connection string
DATABASE_URL=

# --- The model layer. No SDK: both providers are plain HTTP. ---
# Default is Anthropic direct. Set AI_PROVIDER=openrouter to route through
# OpenRouter instead — useful for bulk content, and the wrong place for anything
# touching a customer's credentials.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional overrides. A call site asks for a role, not a model.
# AI_MODEL_DEEP=claude-opus-5
# AI_MODEL_FAST=claude-sonnet-5
# AI_MODEL_CHEAP=claude-haiku-4-5

# --- Operator sign in. At least one of these, or the OS stays sealed. ---

# Magic link is the way in. Who may sign in, comma separated. Defaults to
# derik@aiwrangler.co,van@aiwrangler.co — set this to override.
OPERATOR_EMAILS=

# Delivers the sign-in link. Without it the link is written to the server log
# instead of sent, which is fine on a laptop and not fine anywhere else.
RESEND_API_KEY=
MAIL_FROM="AI Wrangler <login@aiwrangler.co>"


OPERATOR_PASSWORD=

# GitHub OAuth App (https://github.com/settings/developers)
# Callback: http://localhost:3000/api/auth/github/callback  (prod: https://YOUR_DOMAIN/api/auth/github/callback)
# The same app powers "sign in with GitHub" and the agency GitHub connect screen.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Required for GitHub login: who is allowed to run this agency.
OPERATOR_GITHUB_LOGINS=

# Optional fallback if not using the in-app GitHub connect UI
# GITHUB_TOKEN=
# GITHUB_ORG=

# --- Twilio (dialer + SMS). Without these the OS runs in demo mode. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
TWILIO_TWIML_APP_SID=

# --- Zernio (ads across Google / Meta / TikTok / LinkedIn / Pinterest / X / OpenAI). ---
ZERNIO_API_KEY=

# --- Vercel Integration (the customer's own Vercel). Optional: PAT works without it. ---
# Redirect URL on the integration: https://YOUR_DOMAIN/api/auth/vercel/callback
# VERCEL_INTEGRATION_CLIENT_ID=
# VERCEL_INTEGRATION_CLIENT_SECRET=
# VERCEL_INTEGRATION_SLUG=
