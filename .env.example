# Copy to web/.env.local for local dev. Never commit secrets.

TOKEN_ENCRYPTION_KEY=
# 32-byte hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Local only. Production MUST use Postgres.
# DATABASE_PATH=../data/wrangler.db
# DATABASE_URL=postgres://...

# GitHub OAuth App (Sign in with whichever agency account)
# https://github.com/settings/developers
# Callback: http://localhost:3000/api/auth/github/callback  (prod: https://YOUR_DOMAIN/api/auth/github/callback)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional fallback if not using the in-app GitHub connect UI
# GITHUB_TOKEN=
# GITHUB_ORG=

# Vercel Integration (client's Vercel). Callback must exist before this works.
# VERCEL_INTEGRATION_CLIENT_ID=
# VERCEL_INTEGRATION_CLIENT_SECRET=
# VERCEL_INTEGRATION_SLUG=
